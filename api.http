
@baseUrl = http://localhost:3000

### 1. HEALTH - Esperado: 200
GET {{baseUrl}}/api/health

### 2. LISTAR USUARIOS - Esperado: 200
GET {{baseUrl}}/api/users

### 3. BUSCAR JANE - Esperado: 200
GET {{baseUrl}}/api/users/search?keywords=JANE

### 4. BUSCAR SIN KEYWORDS - Esperado: 200
GET {{baseUrl}}/api/users/search

### 5. OBTENER USUARIO EXISTENTE - Esperado: 200
GET {{baseUrl}}/api/users/1

### 6. USUARIO INEXISTENTE - Esperado: 404
GET {{baseUrl}}/api/users/999

### 7. ID INVALIDO - Esperado: 400
GET {{baseUrl}}/api/users/abc

### 8. CREAR USUARIO VALIDO - Esperado: 201
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "  Ada Lovelace ",
  "email": " ADA@Example.com "
}

### 9. EMAIL DUPLICADO - Esperado: 409
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "Ada",
  "email": "ada@example.com"
}

### 10. CREAR USUARIO INVALIDO - Esperado: 400
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "email": "no-es-email"
}

### 11. CAMPO NO PERMITIDO - Esperado: 400
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "Ada",
  "email": "ada2@example.com",
  "role": "admin"
}

### 12. PATCH PARCIAL - Esperado: 200
PATCH {{baseUrl}}/api/users/1
Content-Type: application/json

{
  "name": "John D."
}

### 13. PATCH VACIO - Esperado: 400
PATCH {{baseUrl}}/api/users/1
Content-Type: application/json

{}

### 14. PATCH USUARIO INEXISTENTE - Esperado: 404
PATCH {{baseUrl}}/api/users/999
Content-Type: application/json

{
  "name": "Nadie"
}

### 15. ELIMINAR ADA - Esperado: 204
DELETE {{baseUrl}}/api/users/3

### 16. JSON MAL FORMADO - Esperado: 400
POST {{baseUrl}}/api/users
Content-Type: application/json

{"name":"Ada",}

### 17. RUTA INEXISTENTE - Esperado: 404
GET {{baseUrl}}/api/nope

### 18. ESTADO FINAL - Esperado: 200
GET {{baseUrl}}/api/users


### 1. Crear usuario con password - 201
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "Ada Lovelace",
  "email": "ada@example.com",
  "password": "ClaveDePrueba123!"
}

### 2. Login correcto - 200
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "ada@example.com",
  "password": "ClaveDePrueba123!"
}

### 3. Login con password incorrecta - 401
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "ada@example.com",
  "password": "Incorrecta123!"
}

### 4. Login con email inexistente - 401
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "nadie@example.com",
  "password": "ClaveDePrueba123!"
}

### 5. Ver usuarios sin password - 200
GET {{baseUrl}}/api/users

### 6. Intentar autoasignarse ADMIN - 400
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "Usuario Prueba",
  "email": "prueba@example.com",
  "password": "ClaveDePrueba123!",
  "role": "ROLE_ADMIN"
}

### 7. Cambiar rol sin permisos - 403
PATCH {{baseUrl}}/api/users/1/role
Content-Type: application/json

{
  "role": "ROLE_ADMIN"
}

### 8. Cambiar rol como ROLE_USER - 403
PATCH {{baseUrl}}/api/users/1/role
Content-Type: application/json
x-user-role: ROLE_USER

{
  "role": "ROLE_ADMIN"
}

### 9. Cambiar rol como ROLE_ADMIN - 200
PATCH {{baseUrl}}/api/users/1/role
Content-Type: application/json
x-user-role: ROLE_ADMIN

{
  "role": "ROLE_ADMIN"
}

### 10. Asignar rol invalido - 400
PATCH {{baseUrl}}/api/users/1/role
Content-Type: application/json
x-user-role: ROLE_ADMIN

{
  "role": "SUPERADMIN"
}

### 11. Cambiar password - 200
PATCH {{baseUrl}}/api/users/1
Content-Type: application/json

{
  "password": "NuevaClave456!"
}

### 12. Login con password nueva - 200
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "ada@example.com",
  "password": "NuevaClave456!"
}

### 13. Login con password antigua - 401
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "ada@example.com",
  "password": "ClaveDePrueba123!"
}


### 1. CREAR PACIENTE - 201
# @name createPatient
POST {{baseUrl}}/api/patients
Content-Type: application/json

{
  "firstName": "Ada",
  "lastName": "Lovelace",
  "documentNumber": "30111222",
  "birthDate": "1985-12-10"
}

### 2. LISTAR PACIENTES - 200
GET {{baseUrl}}/api/patients

### 3. BUSCAR POR APELLIDO - 200
GET {{baseUrl}}/api/patients/search?keywords=LOVELACE

### 4. OBTENER PACIENTE - 200
GET {{baseUrl}}/api/patients/{{createPatient.response.body.$.data.id}}

### 5. ACTUALIZAR PACIENTE - 200
PATCH {{baseUrl}}/api/patients/{{createPatient.response.body.$.data.id}}
Content-Type: application/json

{
  "lastName": "Lovelace Byron"
}

### 6. DOCUMENTO REPETIDO - 409
POST {{baseUrl}}/api/patients
Content-Type: application/json

{
  "firstName": "Otra",
  "lastName": "Persona",
  "documentNumber": "30111222",
  "birthDate": "1990-05-10"
}

### 7. BODY INVALIDO - 400
POST {{baseUrl}}/api/patients
Content-Type: application/json

{
  "firstName": "A"
}

### 8. ID NO NUMERICO - 400
GET {{baseUrl}}/api/patients/abc

### 9. ID INEXISTENTE - 404
GET {{baseUrl}}/api/patients/999999

### 10. PATCH VACIO - 400
PATCH {{baseUrl}}/api/patients/{{createPatient.response.body.$.data.id}}
Content-Type: application/json

{}

### 11. CAMPO DESCONOCIDO - 400
POST {{baseUrl}}/api/patients
Content-Type: application/json

{
  "firstName": "Ada",
  "lastName": "Lovelace",
  "documentNumber": "40111222",
  "birthDate": "1985-12-10",
  "role": "ADMIN"
}

### 12. ELIMINAR PACIENTE - 204
DELETE {{baseUrl}}/api/patients/{{createPatient.response.body.$.data.id}}

//@specialtyId = 4

### 1. LISTAR ESPECIALIDADES - 200
GET {{baseUrl}}/api/specialties

### 2. OBTENER ESPECIALIDAD - 200
GET {{baseUrl}}/api/specialties/{{specialtyId}}

### 3. CREAR MEDICO - 201
# @name createDoctor
POST {{baseUrl}}/api/doctors
Content-Type: application/json

{
  "firstName": "Gregory",
  "lastName": "House",
  "licenseNumber": "MN-88421",
  "specialtyId": {{specialtyId}}
}

### 4. LISTAR MEDICOS - 200
GET {{baseUrl}}/api/doctors

### 5. BUSCAR MEDICO - 200
GET {{baseUrl}}/api/doctors/search?keywords=HOUSE

### 6. OBTENER MEDICO - 200
GET {{baseUrl}}/api/doctors/{{createDoctor.response.body.$.data.id}}

### 7. ACTUALIZAR MEDICO - 200
PATCH {{baseUrl}}/api/doctors/{{createDoctor.response.body.$.data.id}}
Content-Type: application/json

{
  "lastName": "House Jr."
}

### 8. MATRICULA DUPLICADA - 409
POST {{baseUrl}}/api/doctors
Content-Type: application/json

{
  "firstName": "Otro",
  "lastName": "Doctor",
  "licenseNumber": "MN-88421",
  "specialtyId": {{specialtyId}}
}

### 9. ESPECIALIDAD INEXISTENTE - 400
POST {{baseUrl}}/api/doctors
Content-Type: application/json

{
  "firstName": "Ana",
  "lastName": "Garcia",
  "licenseNumber": "MN-99999",
  "specialtyId": 999999
}

### 10. ID INVALIDO - 400
GET {{baseUrl}}/api/doctors/abc

### 11. MEDICO INEXISTENTE - 404
GET {{baseUrl}}/api/doctors/999999

### 12. PATCH VACIO - 400
PATCH {{baseUrl}}/api/doctors/{{createDoctor.response.body.$.data.id}}
Content-Type: application/json

{}

### 13. CAMPO DESCONOCIDO - 400
POST {{baseUrl}}/api/doctors
Content-Type: application/json

{
  "firstName": "Ana",
  "lastName": "Garcia",
  "licenseNumber": "MN-12345",
  "specialtyId": {{specialtyId}},
  "role": "ADMIN"
}

### 14. ELIMINAR MEDICO - 204
DELETE {{baseUrl}}/api/doctors/{{createDoctor.response.body.$.data.id}}

