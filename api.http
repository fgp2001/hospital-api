@specialtyId = 1

### 1. Crear paciente para la cita - 201
# @name appointmentPatient
POST {{baseUrl}}/api/patients
Content-Type: application/json

{
  "firstName": "Ada",
  "lastName": "Lovelace",
  "documentNumber": "50981234",
  "birthDate": "1985-12-10"
}

### 2. Crear médico para la cita - 201
# @name appointmentDoctor
POST {{baseUrl}}/api/doctors
Content-Type: application/json

{
  "firstName": "Gregory",
  "lastName": "House",
  "licenseNumber": "MN-901234",
  "specialtyId": {{specialtyId}}
}

### 3. Crear cita - 201
# @name createdAppointment
POST {{baseUrl}}/api/appointments
Content-Type: application/json

{
  "patientId": {{appointmentPatient.response.body.$.data.id}},
  "doctorId": {{appointmentDoctor.response.body.$.data.id}},
  "date": "2026-11-20",
  "reason": "Control de presión arterial"
}

### 4. Listar citas - 200
GET {{baseUrl}}/api/appointments

### 5. Obtener cita por ID - 200
GET {{baseUrl}}/api/appointments/{{createdAppointment.response.body.$.data.id}}

### 6. Buscar por paciente - 200
GET {{baseUrl}}/api/appointments/search?patientId={{appointmentPatient.response.body.$.data.id}}

### 7. Buscar por médico - 200
GET {{baseUrl}}/api/appointments/search?doctorId={{appointmentDoctor.response.body.$.data.id}}

### 8. Buscar por fecha - 200
GET {{baseUrl}}/api/appointments/search?date=2026-11-20

### 9. Combinar filtros - 200
GET {{baseUrl}}/api/appointments/search?patientId={{appointmentPatient.response.body.$.data.id}}&date=2026-11-20

### 10. Buscar con ID inválido - 400
GET {{baseUrl}}/api/appointments/search?patientId=abc

### 11. Buscar con fecha inválida - 400
GET {{baseUrl}}/api/appointments/search?date=20-11-2026

### 12. Crear cita con paciente inexistente - 400
POST {{baseUrl}}/api/appointments
Content-Type: application/json

{
  "patientId": 999999,
  "doctorId": {{appointmentDoctor.response.body.$.data.id}},
  "date": "2026-11-20",
  "reason": "Consulta general"
}

### 13. Actualizar cita - 200
PATCH {{baseUrl}}/api/appointments/{{createdAppointment.response.body.$.data.id}}
Content-Type: application/json

{
  "reason": "Control de seguimiento"
}

### 14. PATCH vacío - 400
PATCH {{baseUrl}}/api/appointments/{{createdAppointment.response.body.$.data.id}}
Content-Type: application/json

{}

### 15. Intentar eliminar paciente con cita - 409
DELETE {{baseUrl}}/api/patients/{{appointmentPatient.response.body.$.data.id}}

### 16. Intentar eliminar médico con cita - 409
DELETE {{baseUrl}}/api/doctors/{{appointmentDoctor.response.body.$.data.id}}

### 17. Eliminar cita - 204
DELETE {{baseUrl}}/api/appointments/{{createdAppointment.response.body.$.data.id}}

### 18. Comprobar que ya no existe - 404
GET {{baseUrl}}/api/appointments/{{createdAppointment.response.body.$.data.id}}

### 19. Eliminar paciente - 204
DELETE {{baseUrl}}/api/patients/{{appointmentPatient.response.body.$.data.id}}

### 20. Eliminar médico - 204
DELETE {{baseUrl}}/api/doctors/{{appointmentDoctor.response.body.$.data.id}}

